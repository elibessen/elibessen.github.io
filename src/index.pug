            #devtools
              a(href='https://ubuntu.com/wsl' target='_blank') WSL (Ubuntu)
              a(style='margin-top: 0rem' href='https://www.virtualbox.org/' target='_blank') VirtualBox
              a(href='https://git-scm.com/' target='_blank') Git
              a(href='https://docs.github.com/en/pages' target='_blank') GitHub Pages
              a(href='https://www.docker.com/' target='_blank') Docker
